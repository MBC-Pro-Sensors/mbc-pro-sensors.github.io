      "ev3": [
        {
          "mode": 1,
          "index": 0,
          "count": 8,
          "format": "int8",
          "note": "IR-SEEK 8×int8 兩路壓一 byte：byte i = convert9(第 2i+1 路)×10 + convert9(第 2i+2 路)（11~99；convert9：0~11→1、12~22→2 … 89~100→9，F16:716-723）"
        },
        {
          "mode": 2,
          "index": 2,
          "count": 2,
          "format": "int8",
          "note": "index 2 = 第 1 路、index 3 = 第 16 路（0~100）"
        },
        {
          "mode": 4,
          "index": 2,
          "count": 2,
          "format": "int8",
          "note": "#67 新：同模式 2"
        }
      ],
      "spike": [
        {
          "mode": 0,
          "hub": "edu",
          "byte": 4,
          "format": "2bit×16",
          "note": "每路 2 bit（(v×10)>>8：0~25→0、26~51→1、52~76→2、77~100→3）；byte4 = 第 5~8 路（第 5 路在 bit7-6）、byte5 = 第 1~4 路、byte6 = 第 13~16 路、byte7 = 第 9~12 路 → App 原始綠 = 第 1~8 路（bit15-14 = 第 1 路）、原始藍 = 第 9~16 路；byte 8~15 = 0"
        },
        {
          "mode": 0,
          "hub": "toy",
          "byte": 4,
          "format": "1bit×16 查表",
          "note": "每路 1 bit（光值 > 50 = 1 亮）：第 1~8 路合成 1 byte（第 1 路在 bit7）經玩具版查表編碼成 byte4~5；第 9~16 路 → byte6~7"
        },
        {
          "mode": 3,
          "byte": 2,
          "count": 2,
          "format": "u8",
          "note": "byte2 = 第 1 路、byte3 = 第 16 路（描述表只宣告 3×int8，第 4 byte 主機可能砍掉）"
        },
        {
          "mode": 6,
          "v": 0,
          "count": 3,
          "note": "byte0~5 = 第 6~11 路光值 → 3×int16，每個 lo = 前一路、hi = 後一路"
        },
        {
          "mode": 8,
          "v": 0,
          "count": 2,
          "note": "byte0~3 = 第 7~10 路（只送 4 B）"
        },
        {
          "mode": 9,
          "v": 0,
          "count": 4,
          "note": "每 int16 四路 4-bit（(v×5)>>5，0~15）：bit0-3 = 第 1 路、bit4-7 = 第 2 路、bit8-11 = 第 3 路、bit12-15 = 第 4 路；v0~v3 = 第 1~16 路"
        }
      ],
      "matrix": {
        "ch22": {
          "cmd": 7,
          "count": 4,
          "note": "C~K 四路一組，每路 2 bit（convert3：0~24→0、25~49→1、50~74→2、75~100→3）：第 1 路在 bit7-6 … 第 4 路在 bit1-0；C = 第 1~4 路、M = 5~8、Y = 9~12、K = 13~16"
        }
      },
      "mvision": null,
      "microbit": {
        "js": "mbc.lineChannel(N)"
