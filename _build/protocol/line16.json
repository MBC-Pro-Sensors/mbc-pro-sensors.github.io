      "id": "10",
      "key": "light",
      "count": 16,
      "name": {
        "zh": "第 N 路光值",
        "en": "channel N reflect"
      },
      "desc": {
        "zh": "第 1~16 路校準後光值 0~100（第 1 路最左）；編號 10~1F",
        "en": "calibrated reflect of channel 1~16, 0~100 (channel 1 = left); ids 10~1F"
